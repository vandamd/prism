+fn write_lp3_completion(path: &Path) -> Result<()> {
+    const PREFIX: &str = "/data/local/tmp/lp3-ksud-completion.";
+    let text = path.to_str().context("Completion path is not UTF-8")?;
+    let nonce = text
+        .strip_prefix(PREFIX)
+        .context("Completion path prefix is invalid")?;
+    if nonce.len() != 32 ||
+        !nonce.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        bail!("Completion path nonce is invalid");
+    }
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .truncate(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)
+        .context("Failed to open the pre-created completion inode")?;
+    file.write_all(b"LP3_KSUD_DONE\n")
+        .context("Failed to write completion record")?;
+    file.sync_all().context("Failed to sync completion record")?;
+    std::fs::write("/data/local/tmp/lp3-ksud-stage", b"completion-written\n")
+        .context("Failed to write completion stage")?;
+    Ok(())
+}
