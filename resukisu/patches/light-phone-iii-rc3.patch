+            version: 0,
+            flags: 0,
+            features: 0,
+            uapi_version: 0,
+        };
+        if ksucalls::ksuctl(crate::android::uapi::KSU_IOCTL_GET_INFO, &raw mut info).is_ok()
+            && info.version != 0
+            && info.flags & crate::android::uapi::KSU_GET_INFO_FLAG_MANAGER_RUST != 0
+        {
+            recognised = true;
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(50));
+    }
+    if !recognised {
+        bail!("KernelSU did not recognise UID {uid} as a manager");
+    }
+    ksucalls::ensure_uapi_version_matched()?;
+    ksucalls::grant_root().context("KernelSU manager root hand-off failed")?;
+
+    let context = std::fs::read_to_string("/proc/self/attr/current")
+        .context("Failed to read the post-hand-off SELinux context")?;
+    if unsafe { libc::getuid() } != 0
+        || unsafe { libc::getgid() } != 0
+        || selinux_context(&context) != "u:r:ksu:s0"
+    {
