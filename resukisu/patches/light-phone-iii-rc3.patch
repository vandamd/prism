+const MODULE: &[u8] = include_bytes!("../../ksud/bin/aarch64/android12-5.10_kernelsu.ko");
+const RESCUE_MODULE: &[u8] = include_bytes!("../bin/lp3_ctlbuf_rescue.ko");
+const INSTALL_MAGIC_1: libc::c_ulong = 0xDEAD_BEEF;
+const INSTALL_MAGIC_2: libc::c_ulong = 0xCAFE_BABE;
+const IOCTL_GRANT_ROOT: libc::c_int = 0x4B01;
+const IOCTL_GET_INFO: libc::c_int = 0x8010_4B02_u32 as libc::c_int;
+const INFO_FLAG_MANAGER: u32 = 1 << 1;
+const UAPI_VERSION: u32 = 4;
+const TARGET_VERMAGIC: &str =
+    "5.10.198-android12-9-g1a2636627c17 SMP preempt mod_unload modversions aarch64";
+static STAGED_MODULE_MAPPING: AtomicPtr<libc::c_void> = AtomicPtr::new(ptr::null_mut());
+
+#[repr(C)]
+#[derive(Default)]
+struct GetInfo {
+    version: u32,
+    flags: u32,
+    features: u32,
+    uapi_version: u32,
+}
+
+fn driver_fd() -> RawFd {
+    let mut fd = -1;
+    unsafe {
+        libc::syscall(
+            libc::SYS_reboot,
+            INSTALL_MAGIC_1,
+            INSTALL_MAGIC_2,
+            0,
+            &raw mut fd,
+        );
+    }
+    fd
+}
+
+fn write_diagnostic(fd: RawFd, message: &str) {
+    if fd < 0 {
+        return;
+    }
+    let mut remaining = message.as_bytes();
+    while !remaining.is_empty() {
+        let written = unsafe { libc::write(fd, remaining.as_ptr().cast(), remaining.len()) };
+        if written <= 0 {
+            return;
+        }
+        remaining = &remaining[written as usize..];
+    }
+    unsafe {
+        libc::fsync(fd);
+    }
+}
+
+fn selinux_context(value: &str) -> &str {
+    value.trim_matches(|character: char| {
+        character == '\0' || character.is_ascii_whitespace()
+    })
+}
+
+fn read_kernel_log() -> Option<String> {
+    const SYSLOG_ACTION_READ_ALL: libc::c_int = 3;
+    const SYSLOG_ACTION_SIZE_BUFFER: libc::c_int = 10;
+    let size = unsafe {
+        libc::klogctl(SYSLOG_ACTION_SIZE_BUFFER, ptr::null_mut(), 0)
+    };
+    if size <= 0 {
+        return None;
+    }
+    let mut buffer = vec![0u8; size as usize + 1];
+    let length = unsafe {
+        libc::klogctl(
+            SYSLOG_ACTION_READ_ALL,
+            buffer.as_mut_ptr().cast(),
+            size,
+        )
+    };
+    if length <= 0 {
+        return None;
+    }
+    buffer.truncate(length as usize);
+    Some(String::from_utf8_lossy(&buffer).into_owned())
+}
+
+struct RelocationError {
+    code: i32,
+}
+
+fn relocation_error(code: i32, _message: impl Into<String>) -> RelocationError {
+    RelocationError { code }
+}
+
+fn relocate_module(kernel_base: u64) -> Result<Vec<u8>, RelocationError> {
+    if kernel_base < 0xffffffc000000000 || kernel_base & 0x1fffff != 0 {
+        return Err(relocation_error(16, "invalid runtime kernel base"));
+    }
+
+    let mut module = MODULE.to_vec();
+    let elf = Elf::parse(&module).map_err(|error| relocation_error(17, error.to_string()))?;
+    let context = *elf.syms.ctx();
+    let mut patches = Vec::with_capacity(SYMBOL_LINK_ADDRESSES.len());
+    let mut resolved = 0usize;
+    for (index, mut symbol) in elf.syms.iter().enumerate() {
+        if index == 0 || symbol.st_shndx != section_header::SHN_UNDEF as usize {
+            continue;
+        }
+        let name = elf
+            .strtab
+            .get_at(symbol.st_name)
+            .ok_or_else(|| relocation_error(18, "unnamed undefined module symbol"))?;
+        if HIDDEN_SYMBOLS.binary_search(&name).is_err() {
+            continue;
+        }
+        let map_index = SYMBOL_LINK_ADDRESSES
+            .binary_search_by_key(&name, |(candidate, _)| *candidate)
+            .map_err(|_| relocation_error(19, format!("missing symbol {name}")))?;
+        let link_address = SYMBOL_LINK_ADDRESSES[map_index].1;
+        let runtime_address =
+            kernel_base
+                .checked_add(link_address.checked_sub(KERNEL_LINK_BASE).ok_or_else(|| {
+                    relocation_error(20, format!("symbol below link base: {name}"))
+                })?)
+                .ok_or_else(|| relocation_error(21, format!("runtime symbol overflow: {name}")))?;
+        symbol.st_shndx = section_header::SHN_ABS as usize;
+        symbol.st_value = runtime_address;
+        let offset = elf.syms.offset() + index * Sym::size_with(elf.syms.ctx());
+        patches.push((offset, symbol));
+        resolved += 1;
+    }
+    if resolved != HIDDEN_SYMBOLS.len() {
+        return Err(relocation_error(
+            22,
+            format!(
+                "resolved {resolved} of {} symbols",
+                HIDDEN_SYMBOLS.len()
+            ),
+        ));
+    }
+    drop(elf);
+    for (offset, symbol) in patches {
+        module
+            .pwrite_with(symbol, offset, context)
+            .map_err(|error| relocation_error(23, error.to_string()))?;
+    }
+    ksuinit::replace_module_vermagic(&mut module, TARGET_VERMAGIC)
+        .map_err(|error| relocation_error(24, format!("{error:#}")))?;
+    Ok(module)
+}
+
+fn replace_fd(fd: RawFd, data: &[u8]) -> Result<(), i32> {
+    if unsafe { libc::ftruncate(fd, data.len() as libc::off_t) } != 0 {
+        return Err(unsafe { *libc::__errno() });
+    }
+    let mut offset = 0usize;
+    while offset < data.len() {
+        let count = unsafe {
+            libc::pwrite(
+                fd,
+                data[offset..].as_ptr().cast(),
+                data.len() - offset,
+                offset as libc::off_t,
+            )
+        };
+        if count < 0 && unsafe { *libc::__errno() } == libc::EINTR {
+            continue;
+        }
+        if count <= 0 {
+            return Err(if count == 0 {
+                libc::EIO
+            } else {
+                unsafe { *libc::__errno() }
+            });
+        }
+        offset += count as usize;
+    }
+    if unsafe { libc::fsync(fd) } != 0 {
+        return Err(unsafe { *libc::__errno() });
+    }
+    Ok(())
+}
+
+fn mapped_rescue() -> Option<&'static mut [u8]> {
+    let mapping = STAGED_MODULE_MAPPING.load(Ordering::Acquire);
+    if mapping.is_null() {
+        return None;
+    }
+    Some(unsafe {
+        std::slice::from_raw_parts_mut(mapping.cast::<u8>(), RESCUE_MODULE.len())
+    })
+}
+
+fn sync_mapping(mapping: &mut [u8]) -> Result<(), i32> {
+    if unsafe {
+        libc::msync(
+            mapping.as_mut_ptr().cast(),
+            mapping.len(),
+            libc::MS_SYNC,
+        )
+    } != 0
+    {
+        return Err(unsafe { *libc::__errno() });
+    }
+    Ok(())
+}
+
+fn restore_rescue_module() -> Result<(), i32> {
+    let mapping = mapped_rescue().ok_or(libc::ENXIO)?;
+    mapping.copy_from_slice(RESCUE_MODULE);
+    sync_mapping(mapping)?;
+    if mapping != RESCUE_MODULE {
+        return Err(libc::EIO);
+    }
+    Ok(())
+}
+
+fn stage_module(rescue_fd: RawFd, kernel_base: u64) -> i32 {
+    let module = match relocate_module(kernel_base) {
+        Ok(module) => module,
+        Err(error) => return error.code,
+    };
+    if module.len() > RESCUE_MODULE.len() ||
+        !STAGED_MODULE_MAPPING.load(Ordering::Acquire).is_null()
+    {
+        return 25;
+    }
+    if unsafe { libc::ftruncate(rescue_fd, RESCUE_MODULE.len() as libc::off_t) } != 0 {
+        return 26;
+    }
+    let mapping = unsafe {
+        libc::mmap(
+            ptr::null_mut(),
+            RESCUE_MODULE.len(),
+            libc::PROT_READ | libc::PROT_WRITE,
+            libc::MAP_SHARED,
+            rescue_fd,
+            0,
+        )
+    };
+    if mapping == libc::MAP_FAILED {
+        return 27;
+    }
+    let bytes = unsafe {
+        std::slice::from_raw_parts_mut(mapping.cast::<u8>(), RESCUE_MODULE.len())
+    };
+    bytes.fill(0);
+    bytes[..module.len()].copy_from_slice(&module);
+    if sync_mapping(bytes).is_err() {
+        unsafe {
+            libc::munmap(mapping, RESCUE_MODULE.len());
+        }
+        let _ = replace_fd(rescue_fd, RESCUE_MODULE);
+        return 28;
+    }
+    STAGED_MODULE_MAPPING.store(mapping, Ordering::Release);
+    0
+}
+
+fn load_staged_module(_rescue_fd: RawFd) -> Result<(), i32> {
+    let mut kmsg = ksuinit::open_kmsg_at_end().ok();
+    let kernel_log_before = read_kernel_log().unwrap_or_default();
+    let mapping = mapped_rescue().ok_or(42)?;
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_init_module,
+            mapping.as_ptr(),
+            mapping.len(),
+            c"".as_ptr(),
+        )
+    };
+    let load_error = if result == 0 {
+        0
+    } else {
+        unsafe { *libc::__errno() }
+    };
+    let mut logs = kmsg
+        .as_mut()
+        .and_then(|file| ksuinit::read_new_kmsg(file).ok())
+        .unwrap_or_default();
+    if let Some(kernel_log_after) = read_kernel_log() {
+        logs.push_str(
+            kernel_log_after
+                .strip_prefix(&kernel_log_before)
+                .unwrap_or(&kernel_log_after),
+        );
+    }
+    if load_error != 0 {
+        if logs.contains("Unknown symbol") {
+            return Err(36);
+        }
+        if logs.contains("version magic") {
+            return Err(37);
+        }
+        if logs.contains("disagrees about version") {
+            return Err(38);
+        }
+        if logs.contains("signature") || logs.contains("module verification") {
+            return Err(39);
+        }
+        if logs.contains("BTF") || logs.contains("btf") {
+            return Err(40);
+        }
+        if logs.contains("invalid ELF") || logs.contains("Invalid ELF") {
+            return Err(45);
+        }
+        if logs.contains("overflow in relocation") {
+            return Err(46);
+        }
+        if logs.contains("unsupported RELA relocation") {
+            return Err(47);
+        }
+        if logs.contains("module PLT section") {
+            return Err(48);
+        }
+        if logs.contains("module symtab section") {
+            return Err(49);
+        }
+        if logs.contains("invalid WRITE|EXEC") {
+            return Err(50);
+        }
+        if logs.contains("exports duplicate symbol") {
+            return Err(51);
+        }
+        if logs.contains("does not import it") {
+            return Err(52);
+        }
+        if logs.contains("module is already loaded") {
+            return Err(53);
+        }
+        if logs.contains("module has no symbols") {
+            return Err(54);
+        }
+        if logs.contains("No module found in object") {
+            return Err(55);
+        }
+        if logs.contains("module_emit_plt_entry") ||
+            logs.contains("plt_num_entries")
+        {
+            return Err(56);
+        }
+    }
+    match load_error {
+        0 => Ok(()),
+        libc::EPERM => Err(11),
+        libc::EINVAL => Err(12),
+        libc::ENOEXEC => Err(15),
+        libc::ENOKEY => Err(13),
+        libc::EKEYREJECTED => Err(14),
+        libc::EBADMSG => Err(30),
+        libc::EFAULT => Err(31),
+        libc::ENOENT => Err(32),
+        libc::ENOMEM => Err(33),
+        libc::EEXIST => Err(34),
+        _ => Err(load_error),
+    }
+}
+
+fn load(manager_uid: u32, diagnostic_fd: RawFd, rescue_fd: RawFd, _kernel_base: u64) -> i32 {
+    if !(10_000..20_000).contains(&manager_uid) {
+        return 1;
+    }
+
+    if !ksuinit::has_kernelsu() {
+        if let Err(code) = load_staged_module(rescue_fd) {
+            let restore = restore_rescue_module();
+            let restore_ok = restore.is_ok();
+            let restore_error = restore.err().unwrap_or(0);
+            write_diagnostic(
+                diagnostic_fd,
+                &format!(
+                    "LP3_RESUKISU_FINIT_ERROR code={code} restored={} restore_errno={}\n",
+                    i32::from(restore_ok),
+                    restore_error,
+                ),
+            );
+            return if restore_ok { code } else { 43 };
+        }
+    }
+
+    if let Err(error) = restore_rescue_module() {
+        write_diagnostic(
+            diagnostic_fd,
+            &format!("LP3_RESUKISU_RESTORE_ERROR errno={error}\n"),
+        );
+        return 44;
+    }
+
+    let uid = manager_uid as libc::uid_t;
+    let gid = manager_uid as libc::gid_t;
+    unsafe {
+        if libc::setgroups(0, std::ptr::null()) != 0 {
+            return 3;
+        }
+        if libc::setresgid(gid, gid, gid) != 0 {
+            return 4;
+        }
+        if libc::setresuid(uid, uid, uid) != 0 {
+            return 5;
+        }
+    }
+
+    let fd = driver_fd();
+    if fd < 0 {
+        return 6;
+    }
+    let mut recognised = false;
+    for _ in 0..100 {
+        let mut info = GetInfo::default();
+        let result = unsafe { libc::ioctl(fd, IOCTL_GET_INFO, &raw mut info) };
+        if result == 0
+            && info.version != 0
+            && info.flags & INFO_FLAG_MANAGER != 0
+            && info.uapi_version == UAPI_VERSION
+        {
+            recognised = true;
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    if !recognised {
+        unsafe { libc::close(fd) };
+        return 7;
+    }
+    if unsafe { libc::ioctl(fd, IOCTL_GRANT_ROOT, std::ptr::null_mut::<u8>()) } != 0 {
+        unsafe { libc::close(fd) };
+        return 8;
+    }
+    unsafe { libc::close(fd) };
+
+    let context = std::fs::read_to_string("/proc/self/attr/current").unwrap_or_default();
+    let uid = unsafe { libc::getuid() };
+    let gid = unsafe { libc::getgid() };
+    let context = selinux_context(&context);
+    if uid != 0 || gid != 0 || context != "u:r:ksu:s0"
+    {
+        write_diagnostic(
+            diagnostic_fd,
+            &format!(
+                "LP3_RESUKISU_IDENTITY_ERROR uid={uid} gid={gid} context={context:?}\n"
+            ),
+        );
+        return 9;
+    }
+    write_diagnostic(
+        diagnostic_fd,
+        &format!(
+            "LP3_RESUKISU_IDENTITY_PASS uid={uid} gid={gid} context={context}\n"
+        ),
+    );
+    0
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lp3_resukisu_probe() -> u32 {
+    0x4C50_3352
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lp3_resukisu_relocate_probe(kernel_base: u64) -> i32 {
+    match relocate_module(kernel_base) {
+        Ok(_) => 0,
+        Err(error) => error.code,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lp3_resukisu_stage(rescue_fd: RawFd, kernel_base: u64) -> i32 {
+    stage_module(rescue_fd, kernel_base)
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn lp3_resukisu_replace(data: *const u8, length: usize) -> i32 {
+    if data.is_null() || length == 0 || length > RESCUE_MODULE.len() {
+        return libc::EINVAL;
+    }
+    let Some(mapping) = mapped_rescue() else {
+        return libc::ENXIO;
+    };
+    let source = unsafe { std::slice::from_raw_parts(data, length) };
+    mapping[..length].copy_from_slice(source);
+    mapping[length..].fill(0);
+    match sync_mapping(mapping) {
+        Ok(()) => 0,
+        Err(error) => error,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn lp3_resukisu_load(
+    manager_uid: u32,
+    diagnostic_fd: RawFd,
+    rescue_fd: RawFd,
+    kernel_base: u64,
+) -> i32 {
+    load(manager_uid, diagnostic_fd, rescue_fd, kernel_base)
+
+}
