+            return Err(std::io::Error::last_os_error()).context("Failed to clear groups");
+        }
+        if libc::setresgid(gid, gid, gid) != 0 {
+            return Err(std::io::Error::last_os_error()).context("Failed to adopt manager GID");
+        }
+        if libc::setresuid(uid, uid, uid) != 0 {
+            return Err(std::io::Error::last_os_error()).context("Failed to adopt manager UID");
+        }
+    }
+
+    if unsafe { libc::getuid() } != uid || unsafe { libc::getgid() } != gid {
+        bail!("manager identity hand-off did not take effect");
+    }
+
+    let mut recognised = false;
+    for _ in 0..100 {
