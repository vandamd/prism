<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Prism" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Prism.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.Prism</item>
    </style>
</resources>
